# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/

# Data — never commit databases or logs
**/data/
**/*.db
**/logs/
*.log

# Environment / secrets
.env
.env.*
*.env
!.env.example

# The PDS's data directory (docker-compose.yml's default location) holds every
# account's signing key. One `git add .` in a node's checkout would publish
# them. Same for tunnel credentials restored next to the repo.
pds-data/
cloudflared/
.cloudflared/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor
.vscode/
.idea/
*.swp
*.swo
